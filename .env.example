# john.goliash.com - settings for deploy.ps1 (Cloudflare Pages project your-pages-project).
#
# OPTIONAL. deploy.ps1 works with no .env at all: the first run opens a browser
# tab to sign in to Cloudflare (npx wrangler login), and that login is reused.
#
# Create .env (copy this file) only if:
#   * your Cloudflare login can see more than one account -> set the account ID, or
#   * you want to deploy without a browser -> set the account ID AND a token.
#
# Account ID: the 32 hex characters in the dashboard URL after dash.cloudflare.com/
# Token: My Profile -> API Tokens -> Create Token -> Custom token, ONE permission:
#        Account . Cloudflare Pages . Edit
# .env is never shipped: deploy.ps1 refuses to upload if it reaches staging.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
